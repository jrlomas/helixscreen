<!-- Batch filament picker - tick rows, then run them as one operation in the
     direction the picker was opened in (Load or Unload). The title and the
     primary caption come from the batch_filament_*_text subjects, which
     BatchFilamentModal::show_owned(for_load) publishes per open. -->
<!-- Rows are populated by BatchFilamentModal; backdrop created by Modal system -->
<component>
  <view name="batch_filament_modal"
        extends="ui_dialog" width="70%" height="content" align="center" flex_flow="column" style_flex_main_place="start"
        style_pad_gap="0">
    <!-- Content area -->
    <lv_obj width="100%"
            height="content" style_pad_all="#space_lg" flex_flow="column" style_flex_cross_place="center"
            style_pad_gap="#space_md">
      <text_heading name="batch_title" width="100%" bind_text="batch_filament_title_text" style_text_align="center"/>
      <ui_multiselect name="batch_multiselect"/>
    </lv_obj>
    <!-- Two-button footer hand-rolled like modal_dialog.xml's: the primary
         caption is the opening direction, so it arrives by subject, which
         modal_button_row's literal text props cannot express. -->
    <divider_horizontal/>
    <lv_obj width="100%" height="#button_height" style_pad_all="0" style_pad_gap="0" flex_flow="row">
      <ui_button name="btn_secondary"
                 height="100%" variant="secondary" flex_grow="1" style_radius="0" style_border_width="0"
                 focusable="false" text="Cancel" translation_tag="Cancel">
        <!-- NOTE: Callbacks wired programmatically per-instance (a real Cancel), not via XML -->
      </ui_button>
      <divider_vertical/>
      <ui_button name="btn_primary"
                 height="100%" flex_grow="1" style_radius="0" style_border_width="0" focusable="false"
                 bind_text="batch_filament_action_text"/>
    </lv_obj>
  </view>
</component>
