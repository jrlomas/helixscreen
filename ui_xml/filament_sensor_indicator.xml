<!-- Filament sensor indicator - nozzle icon showing sensor state -->
<component>
  <api>
    <!-- Per-instance rung subject from the owning tile. Empty by default, so
         a call site that does not size itself installs no binding and keeps
         whatever `size` selects. -->
    <prop name="rung_subject" type="string" default=""/>
    <prop name="size" type="string" default="sm"/>
    <!-- Which runout subject drives the indicator. Defaults to the global,
         all-sensors-aggregate "filament_runout_detected". The in-print status
         panel passes "filament_runout_scoped" so the badge only reflects the
         tools the active print uses (lane truth), not every loaded sensor. -->
    <prop name="subject" type="subject" default="filament_runout_detected"/>
  </api>
  <view name="filament_sensor_indicator"
        extends="lv_obj" width="content" height="content" style_pad_all="0" scrollable="false">
    <!-- Hidden only when no sensor configured (value=-1) -->
    <bind_flag_if_eq subject="$subject" flag="hidden" ref_value="-1"/>
    <!-- Loaded: green nozzle -->
    <icon src="filament" size="$size" variant="success">
      <bind_style_if_eq name="styles.tile_icon_xs" subject="$rung_subject" ref_value="0"/>
      <bind_style_if_eq name="styles.tile_icon_sm" subject="$rung_subject" ref_value="1"/>
      <bind_style_if_eq name="styles.tile_icon_md" subject="$rung_subject" ref_value="2"/>
      <bind_style_if_eq name="styles.tile_icon_lg" subject="$rung_subject" ref_value="3"/>
      <bind_style_if_eq name="styles.tile_icon_xl" subject="$rung_subject" ref_value="4"/>

      <bind_flag_if_not_eq subject="$subject" flag="hidden" ref_value="1"/>
    </icon>
    <!-- Empty: red nozzle-alert -->
    <icon src="filament_alert" size="$size" variant="danger">
      <bind_style_if_eq name="styles.tile_icon_xs" subject="$rung_subject" ref_value="0"/>
      <bind_style_if_eq name="styles.tile_icon_sm" subject="$rung_subject" ref_value="1"/>
      <bind_style_if_eq name="styles.tile_icon_md" subject="$rung_subject" ref_value="2"/>
      <bind_style_if_eq name="styles.tile_icon_lg" subject="$rung_subject" ref_value="3"/>
      <bind_style_if_eq name="styles.tile_icon_xl" subject="$rung_subject" ref_value="4"/>

      <bind_flag_if_not_eq subject="$subject" flag="hidden" ref_value="0"/>
    </icon>
    <!-- Sensor disabled: muted nozzle (runout protection is off) -->
    <icon src="filament" size="$size" variant="disabled">
      <bind_style_if_eq name="styles.tile_icon_xs" subject="$rung_subject" ref_value="0"/>
      <bind_style_if_eq name="styles.tile_icon_sm" subject="$rung_subject" ref_value="1"/>
      <bind_style_if_eq name="styles.tile_icon_md" subject="$rung_subject" ref_value="2"/>
      <bind_style_if_eq name="styles.tile_icon_lg" subject="$rung_subject" ref_value="3"/>
      <bind_style_if_eq name="styles.tile_icon_xl" subject="$rung_subject" ref_value="4"/>

      <bind_flag_if_not_eq subject="$subject" flag="hidden" ref_value="2"/>
    </icon>
  </view>
</component>
